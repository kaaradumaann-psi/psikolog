{
  "name": "psikolog-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Psikologlar için profesyonel çalışma platformu — psikolog.halilkaraduman.com.tr",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
