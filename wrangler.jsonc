{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "psikolog",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "psikolog.halilkaraduman.com.tr/*",
      "custom_domain": true
    }
  ]
}
